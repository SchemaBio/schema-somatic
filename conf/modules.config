// Module configurations

process {
    withName: FASTP {
        cpus = 8
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/mapping:2026Jan'
    }

    withName: BWAMEM {
        cpus = 8
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/mapping:2026Jan'
    }

    withName: BWAMEM2 {
        cpus = 16
        memory = '32 GB'
        container = 'docker.biotools.space/schemabio/mapping:2026Jan'
    }

    withName: MARKDUPLICATES {
        cpus = 4
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/gatk:4.6.2.0'
    }

    withName: MARKDUPLICATESUMI {
        cpus = 4
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/gatk:4.6.2.0'
    }

    withName: MERGEBAMALIGNMENT {
        cpus = 4
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/gatk:4.6.2.0'
    }

    withName: COLLECTQCMETRICS {
        cpus = 4
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/gatk:4.6.2.0'
    }

    withName: LEFTALIGNANDTRIMVARIANTS {
        cpus = 2
        memory = '4 GB'
        container = 'docker.biotools.space/schemabio/gatk:4.6.2.0'
    }

    withName: MUTECT2 {
        cpus = 8
        memory = '16 GB'
        container = 'docker.biotools.space/schemabio/gatk:4.6.2.0'
    }

    withName: EXTRACTUMI {
        cpus = 4
        memory = '8 GB'
        container = 'docker.biotools.space/schemabio/fgbio:2.1.0'
    }

    withName: INDEXALIGNMENT {
        cpus = 2
        memory = '4 GB'
        container = 'docker.biotools.space/schemabio/mapping:2026Jan'
    }

    withName: BAM2FASTQ {
        cpus = 2
        memory = '4 GB'
        container = 'docker.biotools.space/schemabio/mapping:2026Jan'
    }

}