// Include module-specific configurations
includeConfig 'conf/modules.config'

// Nextflow config file for schema-somatic pipeline

manifest {
    name = 'schema-somatic'
    description = 'Somatic mutation analysis pipeline'
    author = 'Your Name'
    version = '1.0.0'
}

params {
    // Default parameters
    input = null
    output = 'results'
    reference = null
    sample_sheet = null
    help = false

    // Resource parameters
    cpus = 8
    memory = '16 GB'

    // Tool-specific parameters
    genome = 'hg38'
    minCoverage = 10
}

process {
    executor = 'local'
    cpus = params.cpus
    memory = params.memory

    // Container settings
    container = 'biocontainers/bwa:latest'
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.container = 'biocontainers/bwa:latest'
    }

    singularity {
        process.executor = 'local'
        singularity.enabled = true
    }

    conda {
        process.executor = 'local'
        conda.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'default'
        process.clusterOptions = '-A your_project'
    }

    kubernetes {
        process.executor = 'k8s'
        pod = [image: 'biocontainers/bwa:latest']
    }
}

// Report settings
report {
    enabled = true
    file = "${params.output}/reports/pipeline_report.html"
}

timeline {
    enabled = true
    file = "${params.output}/reports/timeline.html"
}

dag {
    enabled = true
    file = "${params.output}/reports/pipeline_dag.html"
}

// Cleanup
cleanup {
    enabled = true
    aheadOfTime = true
}